# Copy to .env. Use a password manager for production secrets.
CODESMELL_ENVIRONMENT=development
CODESMELL_DEBUG=false
CODESMELL_WORKSPACE_ROOT=.codesmell-workspaces

CODESMELL_LOGGING__LEVEL=INFO
CODESMELL_LOGGING__JSON_OUTPUT=true

# Ingestion security limits
CODESMELL_INGESTION__MAX_ARCHIVE_BYTES=209715200
CODESMELL_INGESTION__MAX_UNCOMPRESSED_BYTES=1073741824
CODESMELL_INGESTION__MAX_MEMBER_BYTES=16777216
CODESMELL_INGESTION__MAX_MEMBERS=50000
CODESMELL_INGESTION__MAX_COMPRESSION_RATIO=120.0
CODESMELL_INGESTION__MAX_SOURCE_FILES=25000
CODESMELL_INGESTION__GIT_CLONE_TIMEOUT_SECONDS=180
CODESMELL_INGESTION__GIT_ALLOW_ANY_HOST=false

# Database and API
CODESMELL_DATABASE__URL=sqlite:///./codesmell.db
CODESMELL_DATABASE__AUTO_MIGRATE=true
CODESMELL_API__HOST=127.0.0.1
CODESMELL_API__PORT=8000
CODESMELL_API__STORAGE_ROOT=.codesmell-data
CODESMELL_API__MAX_UPLOAD_BYTES=209715200
# CODESMELL_API__CORS_ORIGINS=["http://localhost:5173"]

# M9 authentication and HTTP security
CODESMELL_SECURITY__AUTH_ENABLED=false
CODESMELL_SECURITY__JWT_SECRET=replace-with-at-least-32-random-characters
CODESMELL_SECURITY__ACCESS_TOKEN_MINUTES=60
CODESMELL_SECURITY__BOOTSTRAP_ADMIN_EMAIL=admin@example.org
CODESMELL_SECURITY__BOOTSTRAP_ADMIN_PASSWORD=ReplaceAdmin123
CODESMELL_SECURITY__BOOTSTRAP_ADMIN_NAME=CodeSmell Administrator
CODESMELL_SECURITY__DOCS_ENABLED=true
CODESMELL_SECURITY__TRUSTED_HOSTS=["127.0.0.1","localhost","testserver"]
CODESMELL_SECURITY__FORCE_HTTPS=false

# Worker
CODESMELL_WORKER__POLL_INTERVAL_SECONDS=2
CODESMELL_WORKER__STALE_AFTER_SECONDS=900
CODESMELL_WORKER__HEARTBEAT_INTERVAL_SECONDS=15
CODESMELL_WORKER__DEFAULT_MAX_ATTEMPTS=3

# Explainability and reports
CODESMELL_EXPLAINABILITY__TOP_FEATURES=8
CODESMELL_EXPLAINABILITY__PREFER_SHAP=true
CODESMELL_EXPLAINABILITY__RECOMMENDATIONS_FOR_POSITIVE_ONLY=true
CODESMELL_REPORTS__MAX_ROWS_PER_SECTION=5000
CODESMELL_REPORTS__PDF_MAX_FINDINGS=300
CODESMELL_REPORTS__PDF_MAX_PREDICTIONS=300

# Docker Compose development defaults
POSTGRES_PASSWORD=change-me
CODESMELL_JWT_SECRET=local-development-jwt-secret-change-before-sharing
CODESMELL_ADMIN_EMAIL=admin@local.test
CODESMELL_ADMIN_PASSWORD=ChangeMe12345
CODESMELL_ADMIN_NAME=Local Administrator
